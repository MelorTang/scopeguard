{
  "name": "@scopeguard/pi-runtime",
  "version": "0.5.0-dev",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm --filter @scopeguard/domain build && tsc -p tsconfig.json && node scripts/write-manifest.mjs",
    "typecheck": "pnpm --filter @scopeguard/domain build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@scopeguard/domain": "workspace:*"
  }
}
