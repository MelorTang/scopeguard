{
  "name": "@scopeguard/application",
  "version": "0.5.0-dev",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workbench-layout-persistence": {
      "types": "./dist/workbench-layout-persistence.d.ts",
      "import": "./dist/workbench-layout-persistence.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @scopeguard/pi-runtime build && pnpm --filter @scopeguard/storage-sqlite build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @scopeguard/pi-runtime build && pnpm --filter @scopeguard/storage-sqlite build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@scopeguard/domain": "workspace:*",
    "@scopeguard/pi-runtime": "workspace:*"
  },
  "devDependencies": {
    "@scopeguard/storage-sqlite": "workspace:*"
  }
}
