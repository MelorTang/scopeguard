{
  "name": "scopeguard",
  "private": true,
  "version": "0.5.0-dev",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm --filter @scopeguard/desktop build",
    "typecheck": "pnpm --filter @scopeguard/desktop typecheck",
    "test": "pnpm --filter @scopeguard/domain --filter @scopeguard/storage-sqlite --filter @scopeguard/pi-runtime --filter @scopeguard/application --filter @scopeguard/ipc-contracts --filter @scopeguard/desktop test",
    "dev": "pnpm --filter @scopeguard/desktop dev",
    "dev:web": "pnpm --filter @scopeguard/desktop dev:web",
    "start": "pnpm --filter @scopeguard/desktop start",
    "package:win:dir": "pnpm --filter @scopeguard/desktop package:win:dir",
    "package:win": "pnpm --filter @scopeguard/desktop package:win",
    "smoke:provider": "pnpm --filter @scopeguard/desktop smoke:provider",
    "pilot:local": "pnpm pilot:pi-runtime",
    "pilot:pi-runtime": "pnpm --filter @scopeguard/desktop pilot:pi-runtime",
    "pilot:pi-runtime:staged": "pnpm --filter @scopeguard/desktop pilot:pi-runtime:staged",
    "pilot:phase3": "pnpm --filter @scopeguard/desktop pilot:phase3",
    "pilot:phase3:staged": "pnpm --filter @scopeguard/desktop pilot:phase3:staged",
    "probe:pi-runtime:utility": "pnpm --filter @scopeguard/desktop probe:pi-runtime:utility",
    "probe:pi-runtime:utility:host-node": "pnpm --filter @scopeguard/desktop probe:pi-runtime:utility:host-node",
    "probe:pi-runtime:utility:electron-node": "pnpm --filter @scopeguard/desktop probe:pi-runtime:utility:electron-node",
    "qualify:pi-rpc": "pnpm --dir prototypes/pi-rpc-qualification install --ignore-workspace --frozen-lockfile && pnpm --dir prototypes/pi-rpc-qualification typecheck && pnpm --dir prototypes/pi-rpc-qualification qualify"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "pnpm": "10.0.0",
    "typescript": "^5.9.3"
  }
}
