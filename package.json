{
  "name": "scopeguard",
  "private": true,
  "version": "0.5.0-dev",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm --filter @scopeguard/desktop build",
    "typecheck": "pnpm --filter @scopeguard/desktop typecheck",
    "test": "pnpm --filter @scopeguard/domain --filter @scopeguard/storage-sqlite --filter @scopeguard/agent-runtime --filter @scopeguard/provider-adapters --filter @scopeguard/managed-execution --filter @scopeguard/tool-runtime --filter @scopeguard/application --filter @scopeguard/ipc-contracts --filter @scopeguard/desktop test",
    "dev": "pnpm --filter @scopeguard/desktop dev",
    "dev:web": "pnpm --filter @scopeguard/desktop dev:web",
    "start": "pnpm --filter @scopeguard/desktop start",
    "package:win:dir": "pnpm --filter @scopeguard/desktop package:win:dir",
    "package:win": "pnpm --filter @scopeguard/desktop package:win",
    "package:managed:win": "pwsh -File packages/managed-execution/native/windows/build-managed-companion.ps1",
    "test:managed:install:win": "pwsh -File packages/managed-execution/native/windows/managed-companion-installation-test.ps1",
    "smoke:provider": "pnpm --filter @scopeguard/desktop smoke:provider",
    "pilot:local": "pnpm --filter @scopeguard/desktop pilot:local",
    "qualify:pi-rpc": "pnpm --filter @scopeguard/pi-rpc-qualification qualify"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  }
}
